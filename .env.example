# ─── Supabase ────────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbG...
SUPABASE_SERVICE_ROLE_KEY=eyJhbG...

# ─── monobank еквайринг ──────────────────────────────────────
MONOBANK_TOKEN=...

# ─── Сайт ────────────────────────────────────────────────────
# Потрібен для redirectUrl/webHookUrl у monobank і для Telegram.
# Локально з вебхуками — ngrok http 3000.
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# ─── Пошта (Resend) ──────────────────────────────────────────
# Поки немає власного домену, листи доходять лише на пошту власника
# акаунта Resend. Вхід у кабінет від пошти не залежить — див. CABINET.md 5.5.
RESEND_API_KEY=re_...

# ─── Telegram-бот (запасний вхід) ────────────────────────────
# @BotFather → /newbot. Після заповнення:
#   node scripts/setup-telegram.mjs --set
TELEGRAM_BOT_TOKEN=123456:ABC...
NEXT_PUBLIC_TELEGRAM_BOT=your_bot_username
# Обовʼязковий: Telegram не підписує запити, секрет — єдиний захист вебхука.
TELEGRAM_WEBHOOK_SECRET=довгий-випадковий-рядок

# ─── Заявки з форми (необовʼязково) ──────────────────────────
# TELEGRAM_CHAT_ID=...
# LEAD_EMAIL=you@example.com
